* text=auto
*.py text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.sh text eol=lf

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases
*.sqlite3
*.sqlite3-journal

# Django runtime files
*.log
media/
staticfiles/

# Test, coverage and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Local deployment artifacts
*.pid
